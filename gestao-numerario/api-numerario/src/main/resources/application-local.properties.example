# Exemplo das variaveis exigidas pelo profile local.
# Nao copie credenciais reais para arquivos versionados.
DB_URL=jdbc:mysql://localhost:3306/gestao_numerario?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=numerario_app
DB_PASSWORD=COLOQUE_SUA_SENHA_AQUI

# Minimo de 32 caracteres. Use um valor aleatorio exclusivo por ambiente.
JWT_SECRET=ALTERE_POR_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
